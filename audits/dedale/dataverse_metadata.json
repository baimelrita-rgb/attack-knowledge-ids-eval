Recherche Data Gouv"},"distributorURL":{"typeName":"distributorURL","multiple":false,"typeClass":"primitive","value":"https://entrepot.recherche.data.gouv.fr"},"distributorLogoURL":{"typeName":"distributorLogoURL","multiple":false,"typeClass":"primitive","value":"https://s3.fr-par.scw.cloud/rdg-portal/logos-macarons/Macarons%20Recherche%20Data%20Gouv_Entrep%C3%B4t.png"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"DEDALE is a dataset focused on the detection of APT attacks. It contains both network and host data from the different computers in the emulated IT system. The dataset lasts 4 weeks to reproduce the long lasting characteristics of such attack type. The first two weeks contain only benign activity. From the beginning of the third week, an APT-like attack starts and lasts 8 days. The attack scenario is rather stealthier and there are no brute force or noisy attack types.\n\n<br><br>\nThe dataset is reproducible. All the scripts and configuration files are available here: https://gitlab.inria.fr/mlanvin/rescousse\n\n<br><br>\nMore details on the dataset are given here: https://dedale.inria.fr\n\n<br><br>\nIMPORTANT NOTE\n\n<br><br>\nSome zip containing pcap files are corrupted for now. We are trying to resolve the issue as soon as possible. Here is the list of corrupted files:\n\n<br><br>\n<ul>\n<li>green_internal_week1.zip</li>\n<li>green_internal_week2.zip</li>\n<li>green_internal_week3.zip</li>\n<li>green_internal_week4.zip</li>\n<li>orange_dmz_week3.zip</li>\n<li>router1_green_week3.zip</li>\n<li>router1_orange_week3.zip</li>\n<li>router1_red_week1.zip</li>\n<li>router1_red_week2.zip</li>\n<li>router1_red_week3.zip</li>\n</ul>"},"dsDescriptionLanguage":{"typeName":"dsDescriptionLanguage","multiple":false,"typeClass":"controlledVocabulary","value":"English"},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2026-02-05"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Computer and Information Science"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Intrusion Detection Dataset"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Host Computer Logs"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Network Capture"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Advanced Persistent Threat Detection"}}]},{"typeName":"topicClassification","multiple":true,"typeClass":"compound","value":[{"topicClassValue":{"typeName":"topicClassValue","multiple":false,"typeClass":"primitive","value":"Cybersecurity"}}]},{"typeName":"kindOfData","multiple":true,"typeClass":"controlledVocabulary","value":["Dataset"]},{"typeName":"software","multiple":true,"typeClass":"compound","value":[{"softwareName":{"typeName":"softwareName","multiple":false,"typeClass":"primitive","value":"Rescousse (https://gitlab.inria.fr/mlanvin/rescousse)"},"softwareVersion":{"typeName":"softwareVersion","multiple":false,"typeClass":"primitive","value":"commit : ba47b61e"}},{"softwareName":{"typeName":"softwareName","multiple":false,"typeClass":"primitive","value":"pyCapCutter (https://gitlab.inria.fr/mlanvin/pycapcutter)"},"softwareVersion":{"typeName":"softwareVersion","multiple":false,"typeClass":"primitive","value":"commit : 69a1e1a6"}},{"softwareName":{"typeName":"softwareName","multiple":false,"typeClass":"primitive","value":"Aura (https://gitlab.inria.fr/mlanvin/aura)"},"softwareVersion":{"typeName":"softwareVersion","multiple":false,"typeClass":"primitive","value":"commit : ff48c1d6"}},{"softwareName":{"typeName":"softwareName","multiple":false,"typeClass":"primitive","value":"Scripts de